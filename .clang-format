# Google C++ style with project-specific overrides.
# See https://clang.llvm.org/docs/ClangFormatStyleOptions.html
---
Language: Cpp
BasedOnStyle: Google
Standard: c++11

IndentWidth: 4
ColumnLimit: 120
TabWidth: 4
UseTab: Never

# Keep these consistent with IndentWidth (Google defaults assume 2 spaces).
AccessModifierOffset: -4
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4

DerivePointerAlignment: false
PointerAlignment: Left
...
